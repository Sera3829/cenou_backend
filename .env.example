# ── Base de données (Neon PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ──────────────────────────────────────────────────────────────────
# OBLIGATOIRE, minimum 32 caractères (le serveur refuse de démarrer sinon).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── Environnement ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── CORS ─────────────────────────────────────────────────────────────────
# Origines web supplémentaires autorisées (séparées par des virgules).
# Le dashboard Render et localhost sont déjà autorisés par défaut.
# ALLOWED_ORIGINS=https://mon-dashboard.example.com

# ── Paiements ────────────────────────────────────────────────────────────
# Secret partagé exigé sur POST /api/paiements/callback (header x-callback-secret).
# Sans cette variable, le callback est désactivé (fail closed).
# À remplacer par la vérification HMAC CinetPay lors du branchement.
PAYMENT_CALLBACK_SECRET=
# Mettre à false pour désactiver POST /api/paiements/:id/simuler
PAYMENT_SIMULATION=true

# ── Firebase (sessions + notifications) ──────────────────────────────────
# Contenu JSON du service account, ou placer le fichier
# src/config/firebase-service-account.json (jamais commité).
# FIREBASE_SERVICE_ACCOUNT={"project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_ENABLED=true

# ── Cloudinary (photos de signalements) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
