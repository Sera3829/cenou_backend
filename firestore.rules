rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collection sessions - accès restreint
    match /sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Collection fcm_tokens - accès restreint
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Collection notifications - lecture seule pour l'utilisateur
    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if false; // Seul le backend peut écrire
    }
    
    // Autres collections - accès backend uniquement
    match /{document=**} {
      allow read, write: if false; // Temporaire - backend utilise Admin SDK
    }
  }
}